  "formulas": [
    "Raw TPM = successful input+output tokens / duration minutes",
    "Raw RPM = successful requests / duration minutes",
    "SLA-qualified TPM = SLA-qualified input+output tokens / duration minutes",
    "SLA-goodput = SLA-qualified output tokens / duration seconds",
    "GPU cost = sum(gpu_hours_by_sku * gpu_hour_cost_by_sku)",
    "Cost per 1M total SLA tokens = total cost / SLA input+output tokens * 1,000,000",
    "Cost per 1M input SLA tokens = total cost / SLA input tokens * 1,000,000",
    "Cost per 1M output SLA tokens = total cost / SLA output tokens * 1,000,000",
    "SLA input service cost = H * 1,000,000 * HA factor / (SLA input tokens/sec/GPU * target utilization * 3600)",
    "SLA output service cost = H * 1,000,000 * HA factor / (SLA output tokens/sec/GPU * target utilization * 3600)",
    "Commercial token cost = SLA service cost * other business factor",
    "Suggested token price = commercial token cost / (1 - target gross margin)",
    "Mixed 1M token price = input share * suggested input price + output share * suggested output price",
    "Average request price = avg input tokens / 1M * input price + avg output tokens / 1M * output price",
    "Perf/$ = SLA-qualified TPM / cost per minute",
    "Perf/watt = SLA-qualified TPM / average measured watts",
    "5-factor GPU-hour cost = DC + power + operation + infrastructure + financing, each normalized to monthly cost / GPU count / monthly hours",
    "Power pass-through is reported separately and excluded from service cost; power-included is allocated into service cost"
  ]
